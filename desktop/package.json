{
  "name": "hydrogen-permit-desktop",
  "productName": "수소시설 인허가 가이드",
  "version": "0.1.0",
  "description": "수소시설 인허가 AI 가이드 윈도우 앱 (화면은 서버에서 불러온다)",
  "main": "main.js",
  "author": "강원대학교 WE-Meet 수소 인허가 팀",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "cfb": "1.2.2",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "kr.ac.kangwon.hydrogenpermit",
    "productName": "수소시설 인허가 가이드",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "offline.html", "lib/**", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "수소시설 인허가 가이드",
      "artifactName": "hydrogen-permit-setup-${version}.${ext}"
    }
  }
}
